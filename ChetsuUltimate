local function PlaySoundEffect(soundType)
    task.spawn(function()
        local s = Instance.new("Sound")
        s.Volume = 0.35
        if soundType == "click" then
            s.SoundId = "rbxassetid://6895079853"
            s.PlaybackSpeed = 1.6
        elseif soundType == "toggle" then
            s.SoundId = "rbxassetid://6895079853"
            s.PlaybackSpeed = 2.1
        elseif soundType == "slide" then
            s.SoundId = "rbxassetid://6895079853"
            s.PlaybackSpeed = 1.2
            s.Volume = 0.15
        elseif soundType == "panic" then
            s.SoundId = "rbxassetid://138090596"
            s.PlaybackSpeed = 0.7
            s.Volume = 0.6
        elseif soundType == "pin_err" then
            s.SoundId = "rbxassetid://2865227271"
            s.PlaybackSpeed = 0.9
            s.Volume = 0.5
        end
        s.Parent = SoundService
        s:Play()
        Debris:AddItem(s, 1.5)
    end)
end

