local function AddSlider(parent, text, minVal, maxVal, defaultVal, callback)
    local val = math.clamp(defaultVal, minVal, maxVal)

    local container = New("Frame", {
        Parent           = parent,
        BackgroundColor3 = CurrentTheme.BG,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 46),
        ZIndex           = 2,
    })
    AddCorner(container, 6)
    AddStroke(container, CurrentTheme.CardBorder, 1)
    AddPadding(container, 5, 10, 5, 10)

    local topRow = New("Frame", {
        Parent                 = container,
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Size                   = UDim2.new(1, 0, 0, 16),
        ZIndex                 = 2,
    })

    New("TextLabel", {
        Parent                 = topRow,
        BackgroundTransparency = 1,
        Size                   = UDim2.new(0.7, 0, 1, 0),
        Font                   = FontMain,
        TextSize               = 12,
        TextColor3             = CurrentTheme.TextActive,
        Text                   = text,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 2,
    })

    local valLbl = New("TextLabel", {
        Parent                 = topRow,
        BackgroundTransparency = 1,
        Size                   = UDim2.new(0.3, 0, 1, 0),
        Position               = UDim2.new(0.7, 0, 0, 0),
        Font                   = FontBold,
        TextSize               = 12,
        TextColor3             = CurrentTheme.TextActive,
        Text                   = tostring(val),
        TextXAlignment         = Enum.TextXAlignment.Right,
        ZIndex                 = 2,
    })

    local track = New("Frame", {
        Parent           = container,
        BackgroundColor3 = CurrentTheme.SliderTrack,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 5),
        Position         = UDim2.new(0, 0, 0, 24),
        ZIndex           = 2,
    })
    AddCorner(track, 3)

    local initRatio = (val - minVal) / (maxVal - minVal)
    local fill = New("Frame", {
        Parent           = track,
        BackgroundColor3 = CurrentTheme.SliderFill,
        BorderSizePixel  = 0,
        Size             = UDim2.new(initRatio, 0, 1, 0),
        ZIndex           = 3,
    })
    AddCorner(fill, 3)

    local knob = New("Frame", {
        Parent           = track,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel  = 0,
        Size             = UDim2.new(0, 11, 0, 11),
        Position         = UDim2.new(initRatio, -5, 0.5, -5),
        ZIndex           = 4,
    })
    AddCorner(knob, 6)

    local dragging = false
    local function applyInput(inputX)
        PlaySoundEffect("slide")
        local absPos  = track.AbsolutePosition
        local absSize = track.AbsoluteSize
        local ratio   = math.clamp((inputX - absPos.X) / absSize.X, 0, 1)
        val = math.clamp(math.round(minVal + (maxVal - minVal) * ratio), minVal, maxVal)
        local r = (val - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, -5, 0.5, -5)
        valLbl.Text = tostring(val)
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            applyInput(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            applyInput(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return container
end

