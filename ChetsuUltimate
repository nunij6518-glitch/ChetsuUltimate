local fpsCount, fpsAccum, fpsLast = 0, 0, tick()

RunService.RenderStepped:Connect(function(dt)
    -- FPS, Ping & Clock counter
    fpsCount = fpsCount + 1
    fpsAccum = fpsAccum + dt
    local now = tick()
    if now - fpsLast >= 0.5 then
        local fps = math.round(fpsCount / (now - fpsLast))
        local ping = 0
        pcall(function()
            ping = math.round(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        local timeStr = os.date("%H:%M:%S")
        WatermarkLabel.Text = string.format("CHETSU  |  %d FPS  |  %d ms  |  %s", fps, ping, timeStr)
        HeaderClock.Text    = timeStr
        fpsCount, fpsAccum, fpsLast = 0, 0, now
    end

    -- Update Radar
    UpdateRadar()

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local screenBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

    -- FOV Circle
    local isFovVisible = (_G.ChetsuState.HardAimbot or _G.ChetsuState.RageEnabled) and (not _G.ChetsuState.Spin360)
    if FOVCircleDrawing then
        FOVCircleDrawing.Visible  = isFovVisible
        FOVCircleDrawing.Radius   = _G.ChetsuState.FOVRadius
        FOVCircleDrawing.Position = screenCenter
    elseif FOVCircleGui then
        FOVCircleGui.Visible  = isFovVisible
        FOVCircleGui.Position = UDim2.new(0, screenCenter.X, 0, screenCenter.Y)
        FOVCircleGui.Size     = UDim2.new(0, _G.ChetsuState.FOVRadius * 2, 0, _G.ChetsuState.FOVRadius * 2)
    end

    -- WalkSpeed & ThirdPerson
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= _G.ChetsuState.WalkSpeed and not _G.ChetsuState.Fly then
            hum.WalkSpeed = _G.ChetsuState.WalkSpeed
        end

        if _G.ChetsuState.ThirdPerson then
            LocalPlayer.CameraMaxZoomDistance = _G.ChetsuState.ThirdPersonDist
            LocalPlayer.CameraMinZoomDistance = _G.ChetsuState.ThirdPersonDist
        end
    end

    -- SpinBot
    if _G.ChetsuState.SpinBot and LocalPlayer.Character then
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(_G.ChetsuState.SpinSpeed * 4), 0)
        end
    end

    -- Fly physics
    UpdateFlyPhysics()

    -- Hard Aimbot & Ragebot Logic
    local shouldSnap = (_G.ChetsuState.HardAimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) or _G.ChetsuState.RageEnabled
    if shouldSnap then
        local target = GetClosestTarget()
        if target then
            if not _G.ChetsuState.SilentAim then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            end

            local shouldFire = _G.ChetsuState.AutoWall or (_G.ChetsuState.RageEnabled and _G.ChetsuState.AutoShoot)
            if shouldFire then
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then
                    local ignoreList = { LocalPlayer.Character, ESPFolder }
                    local wallbangHits = N.AutoWall(tool, Camera.CFrame.Position, target, ignoreList)
                    if #wallbangHits > 0 then
                        local lastHit = wallbangHits[#wallbangHits]
                        local isWallbang = lastHit.Wallbang or false
                        local hitRatio   = lastHit.Ratio or 1
                        N.FireEvent(tool, target, hitRatio, isWallbang, 1, false, false)
                    end
                end
            end
        end
    end

    -- 2D Vector Drawing ESP Updates
    for player, holder in pairs(ESPStorage) do
        local isTargetAlive = IsAlive(player)
        local isTeam        = IsTeammate(player)

        if isTargetAlive and not isTeam then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum  = char:FindFirstChildOfClass("Humanoid")

            if root and head and hum then
                if _G.ChetsuState.Chams then
                    holder.Highlight.Adornee          = char
                    holder.Highlight.FillTransparency = _G.ChetsuState.ChamsTransparency
                    holder.Highlight.Enabled          = true
                else
                    holder.Highlight.Enabled          = false
                end

                if hasDrawing then
                    local rootPos, rootOnScreen = Camera:WorldToViewportPoint(root.Position)

                    if rootOnScreen then
                        local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legPos  = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

                        local height = math.abs(headPos.Y - legPos.Y)
                        local width  = height * 0.55
                        local boxPos = Vector2.new(rootPos.X - width / 2, headPos.Y)

                        if _G.ChetsuState.Box2D then
                            holder.BoxOutline.Size     = Vector2.new(width, height)
                            holder.BoxOutline.Position = boxPos
                            holder.BoxOutline.Visible  = true

                            holder.Box.Size            = Vector2.new(width, height)
                            holder.Box.Position        = boxPos
                            holder.Box.Visible         = true
                        else
                            holder.Box.Visible        = false
                            holder.BoxOutline.Visible = false
                        end

                        if _G.ChetsuState.HealthBar then
                            local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                            local barH      = height * healthPct
                            local barX      = boxPos.X - 5

                            holder.HealthBg.From    = Vector2.new(barX, boxPos.Y)
                            holder.HealthBg.To      = Vector2.new(barX, boxPos.Y + height)
                            holder.HealthBg.Visible = true

                            holder.HealthBar.From    = Vector2.new(barX, boxPos.Y + height)
                            holder.HealthBar.To      = Vector2.new(barX, boxPos.Y + height - barH)
                            holder.HealthBar.Color   = Color3.fromRGB(
                                math.round(255 * (1 - healthPct)),
                                math.round(255 * healthPct),
                                0
                            )
                            holder.HealthBar.Visible = true
                        else
                            holder.HealthBg.Visible  = false
                            holder.HealthBar.Visible = false
                        end

                        if _G.ChetsuState.NameESP then
                            holder.Name.Text     = player.DisplayName or player.Name
                            holder.Name.Position = Vector2.new(rootPos.X, boxPos.Y - 15)
                            holder.Name.Visible  = true
                        else
                            holder.Name.Visible  = false
                        end

                        if _G.ChetsuState.DistanceESP and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local distStuds = math.round((root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
                            holder.Distance.Text     = string.format("%d Studs", distStuds)
                            holder.Distance.Position = Vector2.new(rootPos.X, boxPos.Y + height + 2)
                            holder.Distance.Visible  = true
                        else
                            holder.Distance.Visible  = false
                        end

                        if _G.ChetsuState.Snaplines then
                            holder.Tracer.From    = screenBottom
                            holder.Tracer.To      = Vector2.new(rootPos.X, boxPos.Y + height)
                            holder.Tracer.Visible = true
                        else
                            holder.Tracer.Visible = false
                        end

                        if _G.ChetsuState.Skeleton and #holder.Bones > 0 then
                            local bonePairs = {
                                {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
                                {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
                                {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
                                {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
                                {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
                                {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
                                {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
                            }

                            local boneIndex = 1
                            for _, pair in ipairs(bonePairs) do
                                local p1 = char:FindFirstChild(pair[1])
                                local p2 = char:FindFirstChild(pair[2])
                                if p1 and p2 and holder.Bones[boneIndex] then
                                    local s1, o1 = Camera:WorldToViewportPoint(p1.Position)
                                    local s2, o2 = Camera:WorldToViewportPoint(p2.Position)
                                    if o1 and o2 then
                                        holder.Bones[boneIndex].From    = Vector2.new(s1.X, s1.Y)
                                        holder.Bones[boneIndex].To      = Vector2.new(s2.X, s2.Y)
                                        holder.Bones[boneIndex].Visible = true
                                        boneIndex = boneIndex + 1
                                    end
                                end
                            end
                            for i = boneIndex, #holder.Bones do
                                holder.Bones[i].Visible = false
                            end
                        else
                            for _, b in ipairs(holder.Bones) do b.Visible = false end
                        end
                    else
                        if holder.Box then holder.Box.Visible = false end
                        if holder.BoxOutline then holder.BoxOutline.Visible = false end
                        if holder.HealthBg then holder.HealthBg.Visible = false end
                        if holder.HealthBar then holder.HealthBar.Visible = false end
                        if holder.Name then holder.Name.Visible = false end
                        if holder.Distance then holder.Distance.Visible = false end
                        if holder.Tracer then holder.Tracer.Visible = false end
                        for _, b in ipairs(holder.Bones) do b.Visible = false end
                    end
                end
            end
        else
            holder.Highlight.Enabled = false
            if hasDrawing then
                if holder.Box then holder.Box.Visible = false end
                if holder.BoxOutline then holder.BoxOutline.Visible = false end
                if holder.HealthBg then holder.HealthBg.Visible = false end
                if holder.HealthBar then holder.HealthBar.Visible = false end
                if holder.Name then holder.Name.Visible = false end
                if holder.Distance then holder.Distance.Visible = false end
                if holder.Tracer then holder.Tracer.Visible = false end
                for _, b in ipairs(holder.Bones) do b.Visible = false end
            end
        end
    end
end)

