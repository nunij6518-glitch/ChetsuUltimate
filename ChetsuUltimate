-- Render FX loop
RunService.RenderStepped:Connect(function(dt)
    if not MainFrame.Visible then return end
    local time = os.clock()

    -- Snow
    for _, f in ipairs(snowFlakes) do
        local posX = f.Obj.Position.X.Scale + (math.sin(time + f.Phase) * 0.05 + (f.SpeedX / 1000)) * dt
        local posY = f.Obj.Position.Y.Scale + (f.SpeedY / 520) * dt
        if posY > 1.05 then posY = -0.05; posX = math.random() end
        if posX > 1.05 then posX = -0.05 end
        if posX < -0.05 then posX = 1.05 end
        f.Obj.Position = UDim2.new(posX, 0, posY, 0)
    end

    -- Rain
    for _, r in ipairs(rainDrops) do
        local posY = r.Obj.Position.Y.Scale + (r.Speed / 520) * dt
        if posY > 1.05 then posY = -0.05; r.Obj.Position = UDim2.new(math.random(), 0, posY, 0)
        else r.Obj.Position = UDim2.new(r.Obj.Position.X.Scale, 0, posY, 0) end
    end

    -- Particles
    for _, p in ipairs(ambientDots) do
        local px = p.Obj.Position.X.Scale + p.Vx * dt
        local py = p.Obj.Position.Y.Scale + p.Vy * dt
        if px > 1.05 then px = -0.05 elseif px < -0.05 then px = 1.05 end
        if py > 1.05 then py = -0.05 elseif py < -0.05 then py = 1.05 end
        p.Obj.Position = UDim2.new(px, 0, py, 0)
        p.Obj.BackgroundTransparency = 0.5 + (math.sin(time * 2 + p.Phase) * 0.3)
    end

    -- Glow Orbs
    for _, o in ipairs(glowOrbs) do
        local ox = o.Obj.Position.X.Scale + math.sin(time * o.Speed + o.Phase) * 0.0005
        local oy = o.Obj.Position.Y.Scale + math.cos(time * o.Speed * 0.7 + o.Phase) * 0.0005
        o.Obj.Position = UDim2.new(ox, 0, oy, 0)
    end

    -- Aurora
    for _, a in ipairs(auroraBars) do
        local shift = math.sin(time * a.Speed + a.Phase) * 0.08
        a.Obj.Position = UDim2.new(-0.2 + shift, 0, a.Obj.Position.Y.Scale, 0)
        a.Obj.BackgroundTransparency = 0.90 + (math.sin(time + a.Phase) * 0.05)
    end
end)

