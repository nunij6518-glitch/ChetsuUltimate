local function GetGithubAssetSafe(fileName: string, rawUrl: string): string?
    local success, asset = pcall(function()
        if not (isfile and writefile and getcustomasset) then
            return nil
        end
        if not isfile(fileName) then
            local data = game:HttpGet(rawUrl, true)
            if data and #data > 0 then
                writefile(fileName, data)
            end
        end
        return getcustomasset(fileName)
    end)
    if success and asset then
        return asset
    end
    return nil
end

local function LoadAllAssetsAsync(onLoadedCallback: ({[string]: string}) -> ())
    task.spawn(function()
        for key, info in pairs(AssetUrls) do
            local assetId = GetGithubAssetSafe(info.File, info.Url)
            if assetId then
                Assets[key] = assetId
            end
        end
        if onLoadedCallback then
            onLoadedCallback(Assets)
        end
    end)
end

