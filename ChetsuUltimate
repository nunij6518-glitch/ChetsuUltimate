                        PartName = (_G.ChetsuState.AimTarget == "Head" or P.Name:find('Head')) and 'Head' or P.Name,
                        Wallbang = R,
                        Noscope  = T or false,
                        Backstab = U or false,
                        Ratio    = Q or 1
                    }, O, nil, true, Camera.CFrame, P.Position, nil, nil)
                end)
            end
        end
    end
end

