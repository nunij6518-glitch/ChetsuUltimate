        ZIndex                 = 6,
    })

    local arrow = New("TextLabel", {
        Parent                 = header,
        BackgroundTransparency = 1,
        Size                   = UDim2.new(0, 16, 1, 0),
        Position               = UDim2.new(1, -16, 0, 0),
        Font                   = FontBold,
        TextSize               = 10,
        TextColor3             = CurrentTheme.TextMuted,
        Text                   = "v",
        ZIndex                 = 6,
    })

    local dropList = New("Frame", {
        Parent           = wrapper,
        BackgroundColor3 = CurrentTheme.Card,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 0),
        Position         = UDim2.new(0, 0, 0, 34),
        ClipsDescendants = true,
        ZIndex           = 10,
        Visible          = false,
    })
    AddCorner(dropList, 6)
    AddStroke(dropList, CurrentTheme.CardBorder, 1)
    AddPadding(dropList, 3, 3, 3, 3)
    local listLayout = New("UIListLayout", {
        Parent        = dropList,
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder     = Enum.SortOrder.LayoutOrder,
        Padding       = UDim.new(0, 2),
    })

    for i, opt in ipairs(options) do
        local optBtn = New("TextButton", {
            Parent           = dropList,
            BackgroundColor3 = (opt == selected) and CurrentTheme.ActiveTabBG or CurrentTheme.BG,
            BorderSizePixel  = 0,
            Size             = UDim2.new(1, 0, 0, ITEM_H),
            Font             = FontMain,
            TextSize         = 11,
            TextColor3       = (opt == selected) and CurrentTheme.TextActive or CurrentTheme.TextMuted,
            Text             = tostring(opt),
            AutoButtonColor  = false,
            LayoutOrder      = i,
            ZIndex           = 11,
        })
        AddCorner(optBtn, 4)

        optBtn.MouseButton1Click:Connect(function()
            PlaySoundEffect("click")
            selected = opt
            selLbl.Text = tostring(opt)
            isOpen = false
            TweenService:Create(dropList, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 0) }):Play()
            TweenService:Create(arrow, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
            task.delay(0.2, function() dropList.Visible = false end)

            for _, ch in ipairs(dropList:GetChildren()) do
                if ch:IsA("TextButton") then
                    local isChSel = (ch.Text == tostring(opt))
                    ch.BackgroundColor3 = isChSel and CurrentTheme.ActiveTabBG or CurrentTheme.BG
                    ch.TextColor3       = isChSel and CurrentTheme.TextActive or CurrentTheme.TextMuted
                end
            end
            LogEvent(text .. " -> " .. tostring(opt), "info")
            if callback then callback(opt) end
        end)
    end

    local hit = New("TextButton", {
        Parent                 = header,
        BackgroundTransparency = 1,
        Size                   = UDim2.new(1, 0, 1, 0),
        Text                   = "",
        AutoButtonColor        = false,
        ZIndex                 = 7,
    })

    hit.MouseButton1Click:Connect(function()
        PlaySoundEffect("click")
        isOpen = not isOpen
        if isOpen then
            dropList.Visible = true
            TweenService:Create(dropList, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, totalH) }):Play()
            TweenService:Create(arrow, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 180 }):Play()
        else
            TweenService:Create(dropList, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 0) }):Play()
            TweenService:Create(arrow, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
            task.delay(0.2, function() dropList.Visible = false end)
        end
    end)

    return wrapper
end

