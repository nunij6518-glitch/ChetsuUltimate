local function ToggleUI()
    if not _G.ChetsuState.PinUnlocked then return end
    if isAnimating then return end
    isAnimating = true
    if isMenuOpen then
        local tScale = TweenService:Create(UiScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.85 })
        local tFade  = TweenService:Create(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 })
        tScale:Play()
        tFade:Play()
        tScale.Completed:Wait()
        MainFrame.Visible = false
        isMenuOpen = false
        pcall(function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end)
        LogEvent("UI hidden", "warn")
    else
        MainFrame.Visible = true
        UiScale.Scale = 0.85
        MainFrame.BackgroundTransparency = 0
        local tScale = TweenService:Create(UiScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
        local tFade  = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0 })
        tScale:Play()
        tFade:Play()
        tScale.Completed:Wait()
        isMenuOpen = true
        pcall(function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end)
        LogEvent("UI shown", "ok")
    end
    isAnimating = false
end

