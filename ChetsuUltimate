local radarBlips = {}

local function UpdateRadar()
    if not RadarPanel.Visible or not LocalPlayer.Character then return end
    local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for p, b in pairs(radarBlips) do
        if not p.Parent or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
            b:Destroy()
            radarBlips[p] = nil
        end
    end

    local radarRadius = 45
    local maxDistance = 250

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = p.Character.HumanoidRootPart
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local blip = radarBlips[p]
                if not blip then
                    blip = New("Frame", {
                        Parent           = RadarViewport,
                        BorderSizePixel  = 0,
                        AnchorPoint      = Vector2.new(0.5, 0.5),
                        Size             = UDim2.new(0, 4, 0, 4),
                        ZIndex           = 104,
                    })
                    AddCorner(blip, 2)
                    radarBlips[p] = blip
                end

                local isTeammate = (_G.ChetsuState.TeamCheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team)
                blip.BackgroundColor3 = isTeammate and CurrentTheme.Green or CurrentTheme.Red

                local relPos = targetRoot.Position - myRoot.Position
                local camCFrame = Camera.CFrame
                local localX = camCFrame.RightVector:Dot(relPos)
                local localZ = -camCFrame.LookVector:Dot(relPos)

                local distRatio = math.clamp(Vector2.new(localX, localZ).Magnitude / maxDistance, 0, 1)
                local norm = Vector2.new(localX, localZ).Unit
                if localX == 0 and localZ == 0 then norm = Vector2.zero end

                local finalPos = norm * (distRatio * radarRadius)
                blip.Position = UDim2.new(0.5, finalPos.X, 0.5, finalPos.Y)
                blip.Visible  = true
            end
        end
    end
end

