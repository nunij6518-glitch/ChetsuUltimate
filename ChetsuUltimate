            pcall(function()
                if holder.BoxOutline then holder.BoxOutline:Remove() end
                if holder.Box then holder.Box:Remove() end
                if holder.HealthBg then holder.HealthBg:Remove() end
                if holder.HealthBar then holder.HealthBar:Remove() end
