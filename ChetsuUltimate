    if eff == "Snow" and _G.ChetsuState.SnowEnabled then
        local col = SnowColors[_G.ChetsuState.SnowColor] or Color3.fromRGB(255, 255, 255)
        for i = 1, _G.ChetsuState.SnowAmount do
            local sz = _G.ChetsuState.SnowSize + math.random(0, 2)
            local flake = New("Frame", {
                Parent                 = FXContainer,
                BackgroundColor3       = col,
                BackgroundTransparency = math.random(3, 7) / 10,
                Position               = UDim2.new(math.random(), 0, math.random(), 0),
                Size                   = UDim2.new(0, sz, 0, sz),
                ZIndex                 = 0,
            })
            AddCorner(flake, 10)
            table.insert(snowFlakes, {
                Obj    = flake,
                SpeedY = (_G.ChetsuState.SnowSpeed * 0.4) + math.random(10, 40),
                SpeedX = math.random(-15, 15),
                Phase  = math.random() * math.pi * 2
            })
        end
    elseif eff == "Rain" then
        for i = 1, 35 + (_G.ChetsuState.BgIntensity * 5) do
            local drop = New("Frame", {
                Parent                 = FXContainer,
                BackgroundColor3       = Color3.fromRGB(160, 180, 240),
                BackgroundTransparency = 0.5,
                Position               = UDim2.new(math.random(), 0, math.random(), 0),
                Size                   = UDim2.new(0, 1, 0, math.random(12, 24)),
                ZIndex                 = 0,
            })
            table.insert(rainDrops, {
                Obj   = drop,
                Speed = 400 + math.random(50, 250),
            })
        end
    elseif eff == "Particles" then
        for i = 1, 20 + (_G.ChetsuState.BgIntensity * 4) do
            local sz = math.random(2, 4)
            local dot = New("Frame", {
                Parent                 = FXContainer,
                BackgroundColor3       = CurrentTheme.Accent,
                BackgroundTransparency = math.random(4, 8) / 10,
                Position               = UDim2.new(math.random(), 0, math.random(), 0),
                Size                   = UDim2.new(0, sz, 0, sz),
                ZIndex                 = 0,
            })
            AddCorner(dot, 4)
            table.insert(ambientDots, {
                Obj = dot,
                Vx  = (math.random() - 0.5) * 0.08,
                Vy  = (math.random() - 0.5) * 0.08,
                Phase = math.random() * math.pi * 2,
            })
        end
    elseif eff == "Grid" then
        local spacing = math.max(25, 60 - (_G.ChetsuState.BgIntensity * 3))
        for y = 0, 520, spacing do
            New("Frame", {
                Parent                 = FXContainer,
