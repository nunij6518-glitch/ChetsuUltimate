local function LogEvent(msg, level)
    local timeStr = os.date("%H:%M:%S")
    local col = CurrentTheme.TextMuted
    if level == "ok" then col = CurrentTheme.Green
    elseif level == "warn" then col = CurrentTheme.Orange
    elseif level == "err" then col = CurrentTheme.Red
    elseif level == "info" then col = CurrentTheme.Accent
    end

    local line = New("TextLabel", {
        Parent                 = ConsoleScroll,
        BackgroundTransparency = 1,
        Size                   = UDim2.new(1, 0, 0, 14),
        Font                   = Enum.Font.Code,
        TextSize               = 10,
        TextColor3             = col,
        TextXAlignment         = Enum.TextXAlignment.Left,
        Text                   = string.format("[%s] %s", timeStr, tostring(msg)),
        ZIndex                 = 102,
    })

    local children = ConsoleScroll:GetChildren()
    if #children > 60 then
        for i = 1, #children - 60 do
            if children[i]:IsA("TextLabel") then children[i]:Destroy() end
        end
    end
    ConsoleScroll.CanvasPosition = Vector2.new(0, 99999)
end

